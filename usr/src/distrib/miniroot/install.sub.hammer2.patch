 # and autopartitioning during unattended install by asking for and downloading
 # autopartitioning template. Write the resulting fstab to $2. Abort unattended
 # installation if autopartitioning fails.
+# HAMMER2 support -----------------------------------------------------------
+# Ask which filesystem the root disk should use.  Offered only when the
+# ramdisk actually carries the tools (newfs_hammer2 + mount_hammer2), so a
+# stock ramdisk keeps the official ffs-only behaviour.
+ask_root_fstype() {
+	ROOTFSTYPE=ffs
+	[[ -x /sbin/newfs_hammer2 && -x /sbin/mount_hammer2 ]] || return 0
+	ask "Root filesystem type? (ffs or hammer2)" ffs
+	case $resp in
+	[hH]*)	ROOTFSTYPE=hammer2;;
+	*)	ROOTFSTYPE=ffs;;
+	esac
+}
+
+# HAMMER2 layout for the root disk $1; fstab fragment to $2.
+# BIOS biosboot(8) can only read FFS, so the proven 7.8 shape is used:
+#   a = small FFS boot partition (holds stage2 /boot + /etc/boot.conf)
+#   b = swap (RAM size, capped 8G)
+#   d = rest of the disk, HAMMER2 root (PFS subvolumes instead of e/f/g...)
+# disklabel -F knows nothing about hammer2, so the fragment (with the @ROOT
+# PFS label mount syntax) is written here directly.
+hammer2_autolayout() {
+	local _disk=$1 _f=$2 _swap
+
+	# The ramdisk sysctl (distrib/special) does not know hw.physmem and
+	# prints nothing on stdout, which must never reach the arithmetic below
+	# (empty operand -> "unexpected '/'" -> autolayout aborts -> disk loop).
+	# Fall back to dmesg "real mem = N"; the 64M floor covers the rest.
+	_swap=$(sysctl -n hw.physmem 2>/dev/null)
+	[[ $_swap == +([0-9]) ]] || _swap=$(dmesg 2>/dev/null |
+	    sed -n 's/^real mem *= *\([0-9]*\).*/\1/p' | sed -n '$p')
+	[[ $_swap == +([0-9]) ]] || _swap=0
+	_swap=$((_swap / 1048576))
+	[[ $_swap -gt 8192 ]] && _swap=8192
+	[[ $_swap -lt 64 ]] && _swap=64
+
+	disklabel -E $_disk >/dev/null 2>&1 <<-__EOT
+		z
+		a a
+
+		64M
+		4.2BSD
+		a b
+
+		${_swap}M
+		swap
+		a d
+
+		*
+		HAMMER2
+		w
+		q
+	__EOT
+
+	# passno 0 for the hammer2 root: /etc/rc runs 'fsck -p', which would
+	# hand fsck_hammer2 the raw form of the mount device -- /dev/rwd0d@ROOT,
+	# not a device node -- so it exits "open: No such file or directory"
+	# and rc drops to single user.  (fsck_hammer2 does accept -p; teaching
+	# it to strip @LABEL is the other half of the fix, in the tool.)
+	echo "/dev/${_disk}d@ROOT / hammer2 rw 0 0" >$_f
+	echo "/dev/${_disk}a /boot ffs rw 1 2" >>$_f
+}
